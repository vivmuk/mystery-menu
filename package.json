{
  "name": "mystery-menu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first party game: two chefs draft five secret ingredients, bid for them, and the table votes on the dish they would rather eat.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
